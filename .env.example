# PAGER 98 -> EmailJS (see README setup notes). These are public identifiers, not secrets —
# EmailJS's own docs confirm the public key is safe to ship in a client bundle. Real abuse
# protection is the "Allowed origins" allowlist in the EmailJS dashboard, not secrecy of these values.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
